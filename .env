# Strapi
STRAPI_URL=http://localhost:1397
STRAPI_API_TOKEN=replace-with-a-full-access-strapi-api-token

# This service
PORT=4158
INGEST_WEBHOOK_SECRET=replace-with-a-long-random-string   # must match apps/cms .env INGEST_WEBHOOK_SECRET

# Rasterization
PAGE_IMAGE_DPI=150
PAGE_IMAGE_FORMAT=jpeg   # jpeg or png
WORK_DIR=/tmp/newvision-ingest
